# ================================================================
#  TV CRM — FastAPI Backend systemd xizmati
#
#  O'rnatish:
#    sudo cp crm-api.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable crm-api
#    sudo systemctl start crm-api
#
#  Holat tekshirish:
#    sudo systemctl status crm-api
#    sudo journalctl -u crm-api -f
# ================================================================

[Unit]
Description=TV CRM FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/crm/backend

# Virtual muhit faollashtirish va server ishga tushirish
ExecStart=/var/www/crm/backend/venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log

# Muhit o'zgaruvchilari
EnvironmentFile=/var/www/crm/backend/.env

# Avtomatik qayta ishga tushirish
Restart=always
RestartSec=5

# Xotira va protsessor chegaralari
MemoryMax=512M
CPUQuota=80%

# Xavfsizlik
NoNewPrivileges=true
PrivateTmp=true

# Log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crm-api

[Install]
WantedBy=multi-user.target
